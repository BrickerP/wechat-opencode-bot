<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.yupeng.opencode-wechat-bot</string>
  <key>ProgramArguments</key><array>
    <string>__REPO__/run-bot.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/.wechat-opencode-bot/logs/bot.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.wechat-opencode-bot/logs/bot.err.log</string>
</dict></plist>
